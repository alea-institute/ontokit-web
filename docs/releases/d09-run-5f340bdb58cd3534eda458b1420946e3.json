            "authorization": false
          }
        ]
      },
      {
        "title": "after real sign-in the persona-owned private project is visible and a project create succeeds",
        "evidence": [
          {
            "probe": "persona-private-anonymous",
            "tier": "api",
            "method": "GET",
            "path": "/api/v1/projects/{id}",
